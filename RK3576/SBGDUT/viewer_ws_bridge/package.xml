<?xml version="1.0"?>
<package format="3">
  <name>viewer_ws_bridge</name>
  <version>0.1.0</version>
  <description>Safe dummy ROS 2 bridge for the GDUT Qt viewer protocol.</description>
  <maintainer email="maintainer@example.com">SBGDUT</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-websockets</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
